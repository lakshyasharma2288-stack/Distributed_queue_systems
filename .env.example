# Replace the sample values before running the application.
DATABASE_URL=postgresql+psycopg://queue_user:replace-with-a-local-password@localhost:5432/distributed_queue_db
DEBUG=false
REDIS_URL=redis://localhost:6379/0
REDIS_CONNECT_TIMEOUT_SECONDS=1.0
REDIS_SOCKET_TIMEOUT_SECONDS=1.0
QUEUE_KEY=djq:queue:default
ENABLE_QUEUE_INSPECTION=false
OUTBOX_BATCH_SIZE=100
OUTBOX_POLL_INTERVAL_SECONDS=1.0
WORKER_POLL_INTERVAL_SECONDS=1.0
WORKER_HEARTBEAT_INTERVAL_SECONDS=5.0
WORKER_HEARTBEAT_TIMEOUT_SECONDS=30.0
WORKER_LEASE_DURATION_SECONDS=60.0
WORKER_LEASE_RENEWAL_INTERVAL_SECONDS=10.0
DEFAULT_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=5.0
RETRY_MAX_DELAY_SECONDS=300.0
RETRY_JITTER_RATIO=0.2
RETRY_SCHEDULER_BATCH_SIZE=100
MAX_IMAGE_UPLOAD_SIZE_BYTES=10485760
TEST_DATABASE_URL=
REDIS_TEST_URL=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
IMAGE_INPUT_DIR=
IMAGE_OUTPUT_DIR=
PDF_OUTPUT_DIR=
MAX_IMAGE_PIXELS=40000000

# Docker Compose inputs. The password must use URI-unreserved characters.
POSTGRES_DB=distributed_queue_db
POSTGRES_USER=queue_user
POSTGRES_PASSWORD=replace-with-a-local-password
FRONTEND_PORT=8080
VITE_API_BASE_URL=/api
